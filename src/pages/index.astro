---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const SOCIALS = [
	{ label: 'github', href: 'https://github.com/elimchayseng' },
	{ label: 'strava', href: 'https://www.strava.com/athletes/44108500' },
	{ label: 'linkedin', href: 'https://www.linkedin.com/in/elimchayseng/' },
	{ label: 'email', href: 'mailto:elimchayseng13@gmail.com' },
];

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Categorize posts into the two homepage columns. Athletic posts (races,
// training, running thoughts) fall in "Training & Races"; everything else
// (technical write-ups + side projects) falls in "Technical & Projects".
const SECTION_OVERRIDE: Record<string, 'training' | 'tech'> = {
	'first-post': 'tech',
	'up-next': 'tech',
};
const RACE_TAGS = new Set([
	'running', 'marathon', 'race', 'endurance', 'triathlon', 'triathalon',
	'ironman', 'cycling', 'track', 'recap', 'running-thoughts', 'tsp',
	'relay', 'ultra',
]);

function sectionFor(p: (typeof posts)[number]): 'training' | 'tech' {
	if (SECTION_OVERRIDE[p.id]) return SECTION_OVERRIDE[p.id];
	if (p.data.tag === 'Project') return 'tech';
	const tags = (p.data.tags ?? []).map((t) => t.toLowerCase());
	return tags.some((t) => RACE_TAGS.has(t)) ? 'training' : 'tech';
}

const training = posts.filter((p) => sectionFor(p) === 'training');
const tech = posts.filter((p) => sectionFor(p) === 'tech');

const COLUMNS = [
	{ heading: 'Training & Races', posts: training },
	{ heading: 'Technical & Projects', posts: tech },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="page">
			<Header />

			<section class="hero">
				<div class="hero-row">
					<h1>Posts</h1>
					<div class="socials">
						{
							SOCIALS.map((s, i) => (
								<>
									{i > 0 && <span class="sep">·</span>}
									<a
										class="social"
										href={s.href}
										target={s.href.startsWith('mailto') ? undefined : '_blank'}
										rel={s.href.startsWith('mailto') ? undefined : 'noopener'}
									>
										<span>{s.label}</span>
										<span class="arrow">↗</span>
									</a>
								</>
							))
						}
					</div>
				</div>
			</section>

			<section class="columns">
				{
					COLUMNS.map((col) => (
						<div class="col">
							<h2 class="col-head">{col.heading}</h2>
							<div class="list">
								{col.posts.map((post) => (
									<a class="row" href={`/blog/${post.id}/`}>
										<span class="date">
											<FormattedDate date={post.data.pubDate} format="mmdd" />
										</span>
										<span class="entry">
											<span class="title">{post.data.title}</span>
											{post.data.note && (
												<span class="note">{post.data.note}</span>
											)}
										</span>
									</a>
								))}
							</div>
						</div>
					))
				}
			</section>

			<Footer />
		</div>

		<style>
			.page {
				position: relative;
				max-width: 1280px;
				margin: 0 auto;
				padding: 56px 80px;
				min-height: 100vh;
			}

			.hero {
				margin-top: 64px;
			}
			.hero-row {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 24px;
			}
			.hero h1 {
				font-family: var(--sans);
				font-weight: 500;
				font-size: 44px;
				letter-spacing: -0.03em;
				line-height: 1;
				margin: 0;
				color: var(--ink);
			}
			.socials {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 14px;
				font-family: var(--sans);
				font-size: 13px;
				letter-spacing: 0;
			}
			.sep {
				color: var(--ink-faint);
			}
			.social {
				display: inline-flex;
				align-items: baseline;
				gap: 5px;
				color: var(--ink-mute);
				text-decoration: none;
				transition: color 200ms ease;
			}
			.social:hover {
				color: var(--ink);
			}
			.arrow {
				color: var(--ink-faint);
			}

			.columns {
				margin-top: 56px;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 72px;
				align-items: start;
			}
			.col {
				min-width: 0;
			}
			.col-head {
				font-family: var(--sans);
				font-weight: 500;
				font-size: 15px;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: var(--ink-mute);
				margin: 0 0 16px;
			}

			.list {
				min-width: 0;
			}
			.row {
				display: flex;
				align-items: baseline;
				gap: 14px;
				text-decoration: none;
				color: inherit;
				padding: 11px 0;
				transition: color 200ms ease;
			}
			.date {
				font-family: var(--sans);
				font-size: 12.5px;
				color: var(--ink-mute);
				width: 44px;
				font-variant-numeric: tabular-nums;
				flex-shrink: 0;
			}
			.entry {
				display: flex;
				flex-direction: column;
				gap: 3px;
				flex: 1;
				min-width: 0;
			}
			.title {
				font-family: var(--sans);
				font-weight: 400;
				font-size: 18px;
				color: var(--ink);
				letter-spacing: -0.012em;
				line-height: 1.35;
				transition: color 200ms ease;
			}
			.note {
				font-family: var(--sans);
				font-size: 13px;
				color: var(--ink-mute);
				line-height: 1.4;
			}
			.row:hover .title {
				color: var(--hanko);
			}

			@media (max-width: 1024px) {
				.page {
					padding: 48px 56px;
				}
				.columns {
					gap: 56px;
				}
			}

			@media (max-width: 820px) {
				.page {
					padding: 48px 40px;
				}
				.columns {
					grid-template-columns: 1fr;
					gap: 48px;
				}
			}

			@media (max-width: 720px) {
				.page {
					padding: 40px 24px;
				}
				.hero h1 {
					font-size: 32px;
				}
				.hero-row {
					flex-direction: column;
					gap: 8px;
				}
				.title {
					font-size: 17px;
				}
			}
		</style>
	</body>
</html>
